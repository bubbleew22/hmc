rules_version = '2';

// HMC (Hassan Mobile Center) — Firestore Security Rules
// Project: hmc-mobiles
//
// CURRENT STATUS: Sync is NOT yet implemented. The app is offline-first.
// These rules DENY all access by default — safest while sync is being built.
//
// WHEN SYNC IS BUILT: We will integrate Firebase Auth, and update these rules
// to allow authenticated shop operators to read/write their shop's data.
// See the commented template at the bottom.

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny everything by default.
    match /{document=**} {
      allow read, write: if false;
    }

    // ── FUTURE: Sync rules (when Firebase Auth is integrated) ──
    // Uncomment and adapt when the sync system is built:
    //
    // match /shops/{shopId}/{document=**} {
    //   // Only authenticated users belonging to this shop.
    //   allow read, write: if request.auth != null
    //     && request.auth.token.shopId == shopId;
    // }
    //
    // match /shops/{shopId}/sales/{saleId} {
    //   allow read: if request.auth != null
    //     && request.auth.token.shopId == shopId;
    //   allow create: if request.auth != null
    //     && request.auth.token.shopId == shopId
    //     && request.resource.data.operatorId == request.auth.uid;
    //   allow update, delete: if request.auth != null
    //     && request.auth.token.shopId == shopId
    //     && request.auth.token.role == 'admin';
    // }
  }
}
